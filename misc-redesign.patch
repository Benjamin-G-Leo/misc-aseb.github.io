--- /dev/null
+++ b/src/components/ui/SpotlightCard.jsx
@@ -0,0 +1,44 @@
+import { useRef } from "react";
+
+/**
+ * SpotlightCard
+ *
+ * A soft radial glow follows the cursor across the card, plus a subtle
+ * border highlight. `rgb` is the glow colour as "r,g,b".
+ */
+export default function SpotlightCard({
+  children,
+  className = "",
+  rgb = "0,120,212",
+  size = 480,
+  as: Tag = "div",
+  ...rest
+}) {
+  const ref = useRef(null);
+
+  const onMove = (e) => {
+    const el = ref.current;
+    if (!el) return;
+    const r = el.getBoundingClientRect();
+    el.style.setProperty("--mx", `${e.clientX - r.left}px`);
+    el.style.setProperty("--my", `${e.clientY - r.top}px`);
+  };
+
+  return (
+    <Tag
+      ref={ref}
+      onMouseMove={onMove}
+      className={`group relative overflow-hidden ${className}`}
+      {...rest}
+    >
+      <div
+        aria-hidden="true"
+        className="pointer-events-none absolute inset-0 z-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
+        style={{
+          background: `radial-gradient(${size}px circle at var(--mx, 50%) var(--my, 50%), rgba(${rgb},0.20), transparent 45%)`,
+        }}
+      />
+      <div className="relative z-10 h-full">{children}</div>
+    </Tag>
+  );
+}
diff --git a/src/components/ui/TiltCard.jsx b/src/components/ui/TiltCard.jsx
new file mode 100644
index 0000000..257a78a
--- /dev/null
+++ b/src/components/ui/TiltCard.jsx
@@ -0,0 +1,43 @@
+import { useRef } from "react";
+import { motion, useMotionValue, useSpring } from "framer-motion";
+
+/** 3D tilt that follows the cursor, with a moving glare highlight. */
+export default function TiltCard({ children, className = "", max = 7 }) {
+  const ref = useRef(null);
+  const rx = useSpring(useMotionValue(0), { stiffness: 180, damping: 18 });
+  const ry = useSpring(useMotionValue(0), { stiffness: 180, damping: 18 });
+
+  const onMove = (e) => {
+    const r = ref.current.getBoundingClientRect();
+    const px = (e.clientX - r.left) / r.width - 0.5;
+    const py = (e.clientY - r.top) / r.height - 0.5;
+    ry.set(px * max * 2);
+    rx.set(-py * max * 2);
+    ref.current.style.setProperty("--gx", `${(px + 0.5) * 100}%`);
+    ref.current.style.setProperty("--gy", `${(py + 0.5) * 100}%`);
+  };
+  const onLeave = () => {
+    rx.set(0);
+    ry.set(0);
+  };
+
+  return (
+    <motion.div
+      ref={ref}
+      onMouseMove={onMove}
+      onMouseLeave={onLeave}
+      style={{ rotateX: rx, rotateY: ry, transformPerspective: 1000 }}
+      className={`group relative ${className}`}
+    >
+      {children}
+      <div
+        aria-hidden="true"
+        className="pointer-events-none absolute inset-0 z-30 rounded-[inherit] opacity-0 transition-opacity duration-300 group-hover:opacity-100"
+        style={{
+          background:
+            "radial-gradient(260px circle at var(--gx,50%) var(--gy,50%), rgba(255,255,255,0.16), transparent 60%)",
+        }}
+      />
+    </motion.div>
+  );
+}
